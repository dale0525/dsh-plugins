# Build output — regenerated by `build.mjs` (`prepare` / `prepack` run it).
/lib/

# Promotional media: the README screenshots. Kept on disk because the README
# renders them, but this repo is a private self-use fork and does not carry its
# upstream's marketing surface in version control.
#
# `assets/` is deliberately NOT ignored: `assets/edit.png` and
# `assets/recall.png` are build inputs — `build.mjs` base64-inlines them into
# `lib/client.js`, so a fresh clone cannot build without them.
/docs/images/

# Local packaging artifacts
*.tgz
