{
  "name": "@logictan/dsh-context-envelope",
  "version": "0.1.0",
  "description": "Wraps the harness context notes the model reads but the user never said into one <system-reminder> block on the user's own message, at the adapter boundary. Gateways that route on the last user message then read the user's ask again; the transcript and the session log keep every note where it was.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs && node --test \"test/*.spec.mjs\""
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "context",
    "system-reminder",
    "routing"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dale0525/dsh-plugins.git",
    "directory": "packages/dsh-context-envelope"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.6-alpha.1 <0.2.0 || ^0.2.1-rc.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "typescript": "^5.9.0"
  }
}