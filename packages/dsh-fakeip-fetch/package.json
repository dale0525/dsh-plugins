{
  "name": "@logictan/dsh-fakeip-fetch",
  "version": "0.1.0",
  "description": "DSH web_fetch provider that works behind a fake-ip DNS proxy (Clash / sing-box). Narrows the upstream non-public-address guard to the configured reserved range instead of removing it.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "web-fetch",
    "fake-ip",
    "clash",
    "sing-box"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dale0525/dsh-plugins.git",
    "directory": "packages/dsh-fakeip-fetch"
  },
  "dependencies": {
    "ipaddr.js": "^2.5.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-web": "^0.1.6-alpha.2",
    "@deepseek-ai/dsh-web-fetch-http": "^0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
