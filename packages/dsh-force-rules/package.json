{
  "name": "@logictan/dsh-force-rules",
  "version": "0.4.1",
  "description": "DSH plugin that mechanizes five prose rules: no one-shot subagent delegations, no spinning while a seat runs, an upper bound on silence, seat authority limited to the instruction's own marker, and an explicitly named child route on every delegation that can select one. DSH 规则门禁子插件。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "build": "node build.mjs",
    "prepare": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "subagent",
    "delegation",
    "rules",
    "guard",
    "session"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dale0525/dsh-plugins.git",
    "directory": "packages/dsh-force-rules"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
