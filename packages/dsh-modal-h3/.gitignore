# Build output — regenerated by `build.mjs` (`prepare` / `prepack` run it).
/lib/

node_modules/
*.log
.DS_Store

# Python bytecode from the runner and the vendored Modal App. The runner is
# launched with PYTHONDONTWRITEBYTECODE=1, so these only appear when someone ran
# `python app/...` by hand while debugging.
__pycache__/
*.pyc
